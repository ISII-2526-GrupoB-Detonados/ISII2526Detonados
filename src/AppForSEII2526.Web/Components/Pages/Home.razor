@page "/"

@using AppForSEII2526.Web.API;
@inject ISII2526DetonadosAPIClient ApiClient;

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.


<br>
<br>
<br>

@if(_devices is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h3>Devices to Buy</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in _devices)
            {
                <tr>
                    <td>@device.Id</td>
                    <td>@device.Name</td>
                </tr>
            }
        </tbody>
    </table>
}



@code{

    private ICollection<Device_DTO_Comprar> _devices;

    protected override async Task OnInitializedAsync()
    {
        _devices = await ApiClient.GetDevicesComprarDTOsAsync(null,null);
    } 

}