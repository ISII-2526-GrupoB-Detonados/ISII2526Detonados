@page "/rentals/createrental"
@using AppForSEII2526.Web.Components.RentalDialog
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject ISII2526DetonadosAPIClient apiclient
@inject ILogger<Create4Rental> logger
@inject RentalStateContainer rentalState
@inject NavigationManager navigation

<h3>Create Rental</h3>

<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>

    <div class="row">
        <div class="col-8">
            <EditForm Model="@rental" OnValidSubmit="@OpenDialog">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="customerName" class="form-label">Customer Name and Surname</label>
                    <InputText id="customerName" class="form-control"
                               @bind-Value="rental.CustomerNameSurname"
                               placeholder="Name and Surname" />
                </div>

                <div class="mb-3">
                    <label for="deliveryAddress" class="form-label">Delivery Address</label>
                    <InputText id="deliveryAddress" class="form-control"
                               @bind-Value="rental.DeliveryAddress"
                               placeholder="Calle o Carretera..." />
                    <small class="text-muted">Debe incluir "Calle" o "Carretera"</small>
                </div>

                <div class="mb-3">
                    <label for="paymentMethod" class="form-label">Payment Method</label>
                    <InputSelect id="paymentMethod" class="form-select" @bind-Value="rental.PaymentMethod">
                        <option value="@PaymentMethod.CreditCard">Credit Card</option>
                        <option value="@PaymentMethod.PayPal">PayPal</option>
                        <option value="@PaymentMethod.Cash">Cash</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rental Period</label>
                    <div class="row">
                        <div class="col">
                            <label for="rentalFrom" class="form-label">From</label>
                            <InputDate id="rentalFrom" class="form-control"
                                       @bind-Value="rental.RentalDateFrom"
                                       disabled />
                        </div>
                        <div class="col">
                            <label for="rentalTo" class="form-label">To</label>
                            <InputDate id="rentalTo" class="form-control"
                                       @bind-Value="rental.RentalDateTo"
                                       disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col">
                        <!-- Flujo alternativo 4: Deshabilitar botón si no hay dispositivos -->
                        <button type="submit" class="btn btn-primary" id="createRentalButton"
                                disabled="@(!HasDevicesInCart)">
                            Create Rental
                        </button>
                        <button type="button" class="btn btn-secondary"
                                @onclick="CancelRental">
                            Cancel
                        </button>
                        <!-- Flujo alternativo 6: Botón para volver a selección conservando datos -->
                        <button type="button" class="btn btn-info"
                                @onclick="BackToDeviceSelection">
                            Modify Devices
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <div class="col-4">
            <h4>Shopping Cart Summary</h4>

            @if (rental.RentalItems == null || rental.RentalItems.Count == 0)
            {
                <div class="alert alert-warning">
                    No devices selected. Please go back and select devices.
                </div>
            }
            else
            {
                <!-- Flujo alternativo 3: Permitir eliminar dispositivos del carrito -->
                <table class="table table-sm" id="RentalItemsTable">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Model</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in rental.RentalItems)
                        {
                            <tr id="RentalItem_@item.DeviceName">
                                <td>@item.DeviceName</td>
                                <td>@item.DeviceModel</td>
                                <td>@item.DeviceQuantity</td>
                                <td>@item.PriceForRenting.ToString("F2") €</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            @onclick="@(() => RemoveDevice(item))"
                                            title="Remove from cart">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-end">Total:</th>
                            <td id="TotalPrice"><strong>@rental.TotalPrice.ToString("F2") €</strong></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    </div>
</div>

@* Modal popup dialog para confirmar *@
@if (DialogIsOpen)
{
    <DialogRental Caption="Rental devices"
                  Message="Do you want to proceed to rent the selected devices?"
                  OnClose="@OnDialogClose"
                  Type="DialogRental.Category.SaveNot">
    </DialogRental>
}

@code {
    private bool DialogIsOpen;
    private RentalForCreateDTO rental => rentalState.Rental;
    private string errors = "";
    private bool hideErrors => errors.Length == 0;

    // Flujo alternativo 4: Propiedad para verificar si hay dispositivos
    private bool HasDevicesInCart => rental.RentalItems != null && rental.RentalItems.Count > 0;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState.User;

            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                rental.CustomerUserName = user.Identity.Name ?? "";
                logger.LogInformation($"Usuario autenticado: {rental.CustomerUserName}");
            }
        }

        logger.LogInformation($"CustomerUserName al iniciar: '{rental.CustomerUserName}'");

        // Suscribirse a cambios del estado para actualizar la UI
        rentalState.OnChange += StateHasChanged;
    }

    // Liberar suscripción cuando el componente se destruya
    public void Dispose()
    {
        rentalState.OnChange -= StateHasChanged;
    }

    // Flujo alternativo 3: Método para eliminar dispositivo del carrito
    private void RemoveDevice(RentalItemDTO item)
    {
        rentalState.RemoveRentalItemToRent(item);
        logger.LogInformation($"Dispositivo eliminado del carrito: {item.DeviceName}");

        // Actualizar el precio total automáticamente
        StateHasChanged();
    }

    // Flujo alternativo 6: Volver a la selección de dispositivos conservando datos
    private void BackToDeviceSelection()
    {
        logger.LogInformation("Volviendo a selección de dispositivos, conservando datos del formulario");
        navigation.NavigateTo("/rental/selectdevicesforrental");
    }

    private void OpenDialog()
    {
        errors = "";

        // Validaciones antes de abrir el dialog
        if (string.IsNullOrWhiteSpace(rental.CustomerUserName))
        {
            errors = "User authentication error. Please log in again.";
            return;
        }

        if (string.IsNullOrWhiteSpace(rental.CustomerNameSurname))
        {
            errors = "Customer name and surname is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(rental.DeliveryAddress))
        {
            errors = "Delivery address is required.";
            return;
        }

        if (!rental.DeliveryAddress.Contains("Calle") && !rental.DeliveryAddress.Contains("Carretera"))
        {
            errors = "Delivery address must include 'Calle' or 'Carretera'.";
            return;
        }

        if (rental.RentalItems == null || rental.RentalItems.Count == 0)
        {
            errors = "No devices selected for rental.";
            return;
        }

        logger.LogInformation("Todas las validaciones OK, abriendo diálogo");
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (isOk)
        {
            await CreateRentalAsync();
        }
    }

    private async Task CreateRentalAsync()
    {
        try
        {
            logger.LogInformation($"Intentando crear rental para usuario: {rental.CustomerUserName}");
            logger.LogInformation($"DeliveryAddress: {rental.DeliveryAddress}");
            logger.LogInformation($"Items: {rental.RentalItems?.Count ?? 0}");
            logger.LogInformation($"TotalPrice: {rental.TotalPrice}");

            var createdRental = await apiclient.CreateRentalAsync(rental);

            logger.LogInformation($"Rental creado con Id: {createdRental.Id}");

            rentalState.ClearRentingCart();
            navigation.NavigateTo($"/rental/detailrental?RentalID={createdRental.Id}");
        }
        catch (ApiException ex)
        {
            logger.LogError($"API ERROR StatusCode: {ex.StatusCode}");
            logger.LogError($"API ERROR Response: {ex.Response}");
            logger.LogError($"API ERROR Message: {ex.Message}");

            //PARSEAR LOS ERRORES DE VALIDACIÓN
            if (ex.StatusCode == 400 && !string.IsNullOrEmpty(ex.Response))
            {
                try
                {
                    // Intentar extraer errores específicos del ValidationProblemDetails
                    var validationErrors = System.Text.Json.JsonSerializer
                        .Deserialize<ValidationProblemDetails>(ex.Response);

                    if (validationErrors?.Errors != null && validationErrors.Errors.Any())
                    {
                        // Concatenar todos los mensajes de error
                        var errorMessages = validationErrors.Errors
                            .SelectMany(e => e.Value)
                            .ToList();

                        errors = string.Join(" | ", errorMessages);
                        logger.LogError($"Errores de validación: {errors}");
                        return;
                    }
                }
                catch (Exception parseEx)
                {
                    logger.LogWarning($"No se pudo parsear el error de validación: {parseEx.Message}");
                }
            }

            // Si no es error de validación o no se pudo parsear, mostrar mensaje genérico
            errors = $"Error creating rental: {ex.Message}";
        }
        catch (Exception ex)
        {
            logger.LogError($"Unexpected error: {ex.Message}");
            logger.LogError(ex.StackTrace);
            errors = "An unexpected error occurred while creating the rental.";
        }
    }

    private void CancelRental()
    {
        rentalState.ClearRentingCart();
        navigation.NavigateTo("/rental/selectdevicesforrental");
    }
}