@page "/rental/selectdevicesforrental"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ISII2526DetonadosAPIClient apiclient
@inject ILogger<Select4RentalDevices> logger
@inject RentalStateContainer rentalState
@inject NavigationManager navigation

<h3>Select Devices For Rental</h3>

<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>

    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <select class="form-select" @bind="modelSelected" id="selectModel">
                        <option value="All">All</option>
                        @if (modelsNames != null)
                        {
                            @foreach (string modelName in modelsNames)
                            {
                                <option value="@modelName">@modelName</option>
                            }
                        }
                    </select>
                </div>

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon2">Max Price</span>
                        <input type="number" id="inputPrice" @bind="priceForRent"
                               class="form-control" placeholder="Max Price">
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary"
                            @onclick="SearchDevices" id="searchDevices">
                        Search devices
                    </button>
                </div>
            </div>

            <div class="row">
                @if (devices == null)
                {
                    <p>Loading devices...</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Brand</th>
                                    <th>Model</th>
                                    <th>Year</th>
                                    <th>Price For Rent</th>
                                    <th>Rent</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in devices)
                                {
                                    <tr>
                                        <td>@device.Name</td>
                                        <td>@device.Brand</td>
                                        <td>@device.Model</td>
                                        <td>@device.Year</td>
                                        <td>@device.PriceForRent</td>
                                        <td>
                                            <button class="btn btn-outline-secondary"
                                                    @onclick="@(() => AddDevice(device))">
                                                Add
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-4" hidden="@hideRentingCart">
            <h3>Shopping Cart</h3>

            <!-- Flujo alternativo 3: Mostrar precio total actualizado dinámicamente -->
            <div class="alert alert-info mb-3">
                <strong>Total: @rental.TotalPrice.ToString("F2") €</strong>
                <br />
                <small>@rental.RentalItems.Count device(s) selected</small>
            </div>

            @foreach (RentalItemDTO item in rental.RentalItems)
            {
                <div class="row mb-2">
                    <div class="col">
                        <div class="card">
                            <div class="card-body p-2">
                                <button type="button" class="btn btn-sm btn-danger float-end"
                                        @onclick="@(() => RemoveRentalItem(item))"
                                        title="Remove from cart">
                                    &times;
                                </button>
                                <strong>@item.DeviceName</strong>
                                <br />
                                <small>@item.DeviceModel</small>
                                <br />
                                <span class="text-primary">@item.PriceForRenting.ToString("F2")€</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Flujo alternativo 4: Botón deshabilitado si no hay dispositivos -->
            <div class="row mt-3">
                <button type="button" class="btn btn-primary"
                        @onclick="RentDevices"
                        disabled="@(!HasDevicesInCart)">
                    Rent devices (@rental.RentalItems.Count)
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private ICollection<DeviceDTOAlquilar>? devices;
    private string errors = "";
    private string modelSelected = "All";
    private int? priceForRent { get; set; }
    private ICollection<string>? modelsNames = new List<string>();

    private bool hideErrors => errors.Length == 0;

    // RentalStateContainer
    private RentalForCreateDTO rental => rentalState.Rental;
    private bool hideRentingCart => rental.RentalItems.Count == 0;

    // Flujo alternativo 4: Propiedad para verificar si hay dispositivos
    private bool HasDevicesInCart => rental.RentalItems != null && rental.RentalItems.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            modelsNames = await apiclient.GetModelsAsync(null);
        }
        catch (ApiException ex)
        {
            logger.LogError($"GetModelsAsync ERROR: Status={ex.StatusCode}, Content={ex.Response}");
            errors = $"Error loading models: {ex.StatusCode}";
            return;
        }

        try
        {
            devices = await apiclient.GetDevicesAsync(null, null);
        }
        catch (ApiException ex)
        {
            logger.LogError("Error GetDevicesAsync: " + ex);
            errors = "Error loading devices.";
        }

        // Suscribirse a cambios del estado para actualizar la UI automáticamente
        rentalState.OnChange += StateHasChanged;

        logger.LogInformation($"Página cargada. Dispositivos en carrito: {rental.RentalItems.Count}");
    }

    // Liberar suscripción cuando el componente se destruya
    public void Dispose()
    {
        rentalState.OnChange -= StateHasChanged;
    }

    private void AddDevice(DeviceDTOAlquilar device)
    {
        rentalState.AddDeviceToRental(device);
        logger.LogInformation($"Dispositivo añadido: {device.Name}. Total en carrito: {rental.RentalItems.Count}");
    }

    // Flujo alternativo 3: Al eliminar, el precio se actualiza automáticamente
    private void RemoveRentalItem(RentalItemDTO item)
    {
        rentalState.RemoveRentalItemToRent(item);
        logger.LogInformation($"Dispositivo eliminado: {item.DeviceName}. Total en carrito: {rental.RentalItems.Count}");
    }

    private void RentDevices()
    {
        if (HasDevicesInCart)
        {
            logger.LogInformation($"Navegando a crear rental con {rental.RentalItems.Count} dispositivos");
            navigation.NavigateTo("/rentals/createrental");
        }
    }

    public async void SearchDevices()
    {
        try
        {
            string deviceModel = (modelSelected == "All") ? null : modelSelected;

            devices = await apiclient.GetDevicesAsync(deviceModel, priceForRent);
            logger.LogInformation($"Búsqueda completada. Dispositivos encontrados: {devices?.Count ?? 0}");
        }
        catch (ApiException ex)
        {
            logger.LogError($"Error searching devices: {ex}");
            errors = "Error while searching devices.";
        }

        StateHasChanged();
    }
}