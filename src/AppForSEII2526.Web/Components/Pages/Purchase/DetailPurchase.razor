@page "/purchase/detailpurchase"


@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject ISII2526DetonadosAPIClient apiclient

<h3>DetailPurchase</h3>

@attribute [Authorize]

@if (purchase == null)
{
    <p>@error</p>
}
else
{

<table class="table table-borderless table-sm">
    <tr>
        <th>Name and Surname</th>
        <td id="NameSurname">@purchase.CustomerUserName @purchase.CustomerNameSurname</td>
    </tr>
    <tr>
        <th>Delivery Address</th>
        <td id="DeliveryAddress">@purchase.DeliveryAddress</td>
    </tr>
    <tr>
        <th>Purchase Date</th>
        <td id="PurchaseDate">@purchase.PurchaseDate</td>
    </tr>
    <tr>
        <th>Total Price</th>
        <td id="TotalPrice">@purchase.TotalPrice.ToString("N2")</td>
    </tr>
    <tr>
        <th>Payment Method</th>
        <td id="PaymentMethod">@purchase.PaymentMethod</td>
    </tr>

</table>

<h4>Purchased Devices</h4>

<table class="table" id="PurchasedDevices">
    <thead>
        <tr>
            <th scope="col">Brand</th>
            <th scope="col">Model</th>
            <th scope="col">Color</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
            <th sccope="col">Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Purchase_Item_DTO item in purchase.PurchaseItems)
        {
            <tr id="PurchaseItem_@item.Name">
                <td>@item.Brand</td>
                <td>@item.Model</td>
                <td>@item.Color</td>
                <td>@item.Price.ToString("N2") €</td>
                <td>@item.Quantity</td>
                <td>@item.Description</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <th scope="row" colspan="2" class="text-end">Total Price</th>
        <td id="TotalPrice">@purchase.TotalPrice.ToString("N2") €</td>
    </tfoot>

</table>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int PurchaseID { get; set; }
    private Purchase_Detail_DTO purchase;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }


    protected override async Task OnInitializedAsync()
    {
        string userName = "";
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("User"))
                {
                    userName = user.Identity.Name;
                }
            }

        }

        try
        {
            purchase = await apiclient.GetPurchaseAsync(PurchaseID);
        }
        catch (ApiException exception)
        {
            purchase = null;
        }
        if ((purchase == null) || (purchase.CustomerUserName != userName))
        {
            error = $"Error! You are not authorized to see this purchase or there is not a purchase with id={PurchaseID}";
        }
    }

}