@page "/purchases/createpurchase"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject ISII2526DetonadosAPIClient apiclient
@inject ILogger<CreatePurchase> logger
@inject PurchaseStateContainer purchaseState

@attribute [Authorize]

<h3>CreatePurchase</h3>

@* purchase is the object that will be edited thanks to the form *@
<EditForm Model="purchase" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidatonSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.CustomerUserName" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.CustomerNameSurname" class="form-control" id="Surname" />
                <label for="Name">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col.md">
            <div class="from-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="from-select" @bind-Value="purchase.PaymentMethod" id="PaymentMethod">
                    <option value="@PaymentMethod.CreditCard" default> CreditCard</option>
                    <option value="@PaymentMethod.PayPal"> PayPal</option>
                    <option value="@PaymentMethod.Cash"> Cash</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to purchase the devices*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Purchase your devices
                </button>
            </div>
        </div>
    </div>
    <h4>Purchase detail</h4>
    <p>
        <b>Total price:</b> @CurrentTotalPrice.ToString("N2") €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyPurchaseItems" id="ModifyDevices">
            Modify Devices
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfPurchaseItems">
            <thead>
                <tr>
                    <th>Brand</th>
                    <th>Model</th>
                    <th>Color</th>
                    <th>Price For Purchase</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in purchase.PurchaseItems) {
                    <tr id="DeviceData_@item.Name">
                        <td>@item.Brand</td>
                        <td>@item.Model</td>
                        <td>@item.Color</td>
                        <td>@item.Price.ToString("N2")</td>
                        <td><InputText @bind-Value="item.Description" class="form-control" id="@($"description_{item.DeviceID}")" /></td>
                    </tr>
                    
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to purchase*@
@if (DialogIsOpen)
{
    <Dialog Caption="Purchase devices"
    Message="Do you want to proceed to purchase the selected devices?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool purchaseButtonDisabled { get { return (purchase.PurchaseItems == null || purchase.PurchaseItems.Count == 0); } }
    private bool DialogIsOpen;

    private double CurrentTotalPrice
    {
        get
        {
            if (purchase?.PurchaseItems == null) return 0;
            return purchase.PurchaseItems.Sum(item => item.Price * item.Quantity);
        }
    }

    private void ModifyPurchaseItems()
    {
        navigation.NavigateTo("/purchase/selectdevicesforpurchase");
    }

    private Purchase_ForCreate_DTO purchase => purchaseState.Purchase;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOK) {

        DialogIsOpen = false;
        if (isOK) {
            // Process the data introduced by the user if they are valid
            if (purchase.PurchaseItems.Count > 0)
            {
                try
                {
                    var purchased = await apiclient.CreatePurchaseAsync(purchase);
                    purchaseState.PurchaseProcessed();
                    navigation.NavigateTo($"/purchase/detailpurchase/?PurchaseID={purchased.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)

                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    messageError = "An error occurred while creating the purchase. Please try again later.";
                }

            }
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if(authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if(user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    purchase.CustomerUserName = user.Identity.Name;
                }
            }
        }
        purchase.CustomerUserName = purchase.CustomerUserName == null ? "" : purchase.CustomerUserName;
        purchase.CustomerNameSurname = purchase.CustomerNameSurname == null ? "" : purchase.CustomerNameSurname;
        purchase.DeliveryAddress = purchase.DeliveryAddress == null ? "" : purchase.DeliveryAddress;

        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        StateHasChanged();
    }
}
