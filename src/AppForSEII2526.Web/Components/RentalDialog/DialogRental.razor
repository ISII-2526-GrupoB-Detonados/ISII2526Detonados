<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Caption</h5>
            </div>
            <div class="modal-body">
                <p>@Message</p>
            </div>
            <div class="modal-footer">
                @if (Type == Category.SaveNot)
                {
                    <button type="button" class="btn btn-primary" @onclick="@(() => Close(true))">
                        Yes
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="@(() => Close(false))">
                        No
                    </button>
                }
                else if (Type == Category.Okay)
                {
                    <button type="button" class="btn btn-primary" @onclick="@(() => Close(true))">
                        OK
                    </button>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

@code {
    [Parameter]
    public string Caption { get; set; } = "Confirm";

    [Parameter]
    public string Message { get; set; } = "Are you sure?";

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    [Parameter]
    public Category Type { get; set; } = Category.SaveNot;

    public enum Category
    {
        SaveNot,
        Okay
    }

    private async Task Close(bool result)
    {
        await OnClose.InvokeAsync(result);
    }
}